# App
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Taku reward callback sec_key from the Taku console; never use the public App Key.
# Leave empty until the App sends the SDK user ID and session extra data.
TAKU_SEC_KEY=

# Database
POSTGRES_DB=ad_member
POSTGRES_USER=ad_member
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://ad_member:replace-with-a-strong-database-password@postgres:5432/ad_member

# Local static shell proxy
PORT=3000
BACKEND_ORIGIN=http://127.0.0.1:8000

# Alipay RSA2 public-key mode. Configure merchant transfer permission first.
# Store PEM files outside the repo; use real process env vars for local Python.
PAYMENT_PROVIDER=
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_TIMEOUT=10
ALIPAY_NOTIFY_URL=

# Aliyun SAF enhanced device risk (device_risk_pro), backend only
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_RISK_REGION=cn-shanghai

# APP JSON audit to stderr / systemd journal; 0 disables, sensitive fields redacted
APP_JSON_AUDIT_ENABLED=1
