# App
APP_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Taku reward callback sec_key from the Taku console; never use the public App Key.
# Leave empty until the App sends the SDK user ID and session extra data.
TAKU_SEC_KEY=
# Host directory containing the keyring; container path must use /run/taku-ecpm/.
TAKU_ECPM_KEY_DIR=./secrets
TAKU_ECPM_KEYRING_FILE=

# Database
POSTGRES_DB=ad_member
POSTGRES_USER=ad_member
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://ad_member:replace-with-a-strong-database-password@postgres:5432/ad_member

# Local static shell proxy
PORT=3000
BACKEND_ORIGIN=http://127.0.0.1:8000

# Alipay RSA2 public-key mode. Configure merchant transfer permission first.
# Store PEM files outside the repo; use real process env vars for local Python.
PAYMENT_PROVIDER=
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
# Certificate mode: configure all three paths instead of ALIPAY_PUBLIC_KEY_PATH.
ALIPAY_APP_CERT_PATH=
ALIPAY_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=
# Docker: host directory mounted read-only at /run/payment-keys.
# Set the two PATH variables above to /run/payment-keys/<filename>.
ALIPAY_KEY_DIR=./secrets
ALIPAY_TIMEOUT=10
ALIPAY_NOTIFY_URL=
# Use the exact approved scene and reporting fields from the Alipay merchant console.
ALIPAY_TRANSFER_SCENE_NAME=
ALIPAY_TRANSFER_SCENE_REPORT_INFOS=[]

# Aliyun SAF enhanced device risk (device_risk_pro), backend only
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_RISK_REGION=cn-shanghai

# APP JSON audit to stderr / systemd journal; 0 disables, sensitive fields redacted
APP_JSON_AUDIT_ENABLED=1

# Aliyun SMS: approved signature and verification template with code parameter
SMS_PROVIDER=aliyun
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=

# Zhongtian SMS: set SMS_PROVIDER=zthy to enable. Password is the original API password.
SMS_ZTHY_USERNAME=
SMS_ZTHY_PASSWORD=
SMS_ZTHY_SIGNATURE=
SMS_ZTHY_TEMPLATE_ID=
SMS_ZTHY_CODE_VARIABLE=code
# Additional approved template variables, e.g. {"minutes":"5"}.
SMS_ZTHY_TEMPLATE_PARAMS={}
