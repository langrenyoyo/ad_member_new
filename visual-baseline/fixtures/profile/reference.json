          "formatter": "function (value, row, index) {\n                    value = value == null || value.length === 0 ? '' : value.toString();\n                    return '<div class=\"input-group input-group-sm\" style=\"width:250px;margin:0 auto;\"><input type=\"text\" class=\"form-control input-sm\" value=\"' + value + '\"><span class=\"input-group-btn input-group-sm\"><a href=\"' + value + '\" target=\"_blank\" class=\"btn btn-default btn-sm\"><i class=\"fa fa-link\"></i></a></span></div>';\n                }"
        },
        {
          "field": "ip",
          "title": "ip",
          "visible": true,
          "sortable": false,
          "operate": null,
          "formatter": "function (value, row, index) {\n                    var field = this.field;\n                    if (typeof this.customField !== 'undefined' && typeof row[this.customField] !== 'undefined') {\n                        value = row[this.customField];\n                        field = this.customField;\n                    }\n                    return '<a href=\"javascript:;\" class=\"searchit\" data-toggle=\"tooltip\" title=\"' + __('Click to search %s', value) + '\" data-field=\"' + field + '\" data-value=\"' + value + '\">' + value + '</a>';\n                }"
        },
        {
          "field": "createtime",
          "title": "操作时间",
          "visible": true,
          "sortable": true,
          "operate": "RANGE",
          "formatter": "function (value, row, index) {\n                    var datetimeFormat = typeof this.datetimeFormat === 'undefined' ? 'YYYY-MM-DD HH:mm:ss' : this.datetimeFormat;\n                    if (isNaN(value)) {\n                        return value ? Moment(value).format(datetimeFormat) : __('None');\n                    } else {\n                        return value ? Moment(parseInt(value) * 1000).format(datetimeFormat) : __('None');\n                    }\n                }"
        }
      ]
